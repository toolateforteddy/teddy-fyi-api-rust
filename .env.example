# Database configuration template - Copy to .env and fill in real values
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_SECRET=dev_secret_key_123
GEMINI_API_KEY=dev_placeholder_api_key
# Comma-separated client IDs of the iOS apps. Each is also accepted as a token
# audience, since iOS sign-in sends the app's own client ID as `aud`.
GOOGLE_IOS_CLIENT_IDS=
# Comma-separated client IDs for everything that is not an iOS app.
# Leave both empty for local dev, which signs in with `mock.` tokens.
GOOGLE_CLIENT_IDS=
