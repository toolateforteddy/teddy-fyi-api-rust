# Database configuration template - Copy to .env and fill in real values
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_SECRET=dev_secret_key_123
GEMINI_API_KEY=dev_placeholder_api_key
# Per-product client IDs, comma-separated. These are the ones to use: an ID listed here
# also tells the service which product a session belongs to, which is what puts the
# `product` claim in the access token and lets `/api/sync` refuse a scope belonging to the
# other product. iOS client IDs belong here too. See src/auth/client_ids.rs.
TEDDY_FYI_CLIENT_IDS=
SCRIBBLEROUTE_CLIENT_IDS=
# ScribbleKeep Cloud's own Android client ID, a single value. Classified as a ScribbleRoute
# audience by the name of this variable, so it needs no entry in SCRIBBLEROUTE_CLIENT_IDS.
# In production it comes from the `scribbleroute-keepcloud-client-id` secret; leave it empty
# for local dev like the rest.
SCRIBBLEKEEP_CLOUD_CLIENT_ID=
# Comma-separated client IDs of the iOS apps. Each is also accepted as a token
# audience, since iOS sign-in sends the app's own client ID as `aud`. This one spans both
# products, so an ID that only appears here signs in fine but carries no product claim and
# its sync scopes cannot be enforced -- list it above as well to close that.
GOOGLE_IOS_CLIENT_IDS=
# Comma-separated client IDs for everything that is not an iOS app. Also product-blind;
# prefer the two per-product vars above.
# Leave all of them empty for local dev, which signs in with `mock.` tokens -- those are accepted
# only by a binary built with `--features dev-auth`, which is what `make dev` builds. That
# build also refuses to start if any real Google client ID *is* configured, so leave these
# empty locally. Conversely a normal build (release, Docker, `make run`) refuses to start
# with them empty, because it could then never authenticate anybody.
GOOGLE_CLIENT_IDS=
# Domain attribute on the session cookie. Defaults to `.teddy.fyi`; empty means "no Domain
# attribute", i.e. a host-only cookie, which is what a single-host deployment wants. This
# affects the cookie and nothing else -- it used to double as the switch for the `mock.`
# login bypass, which made an empty value a silent authentication bypass.
COOKIE_DOMAIN=
# Concurrency caps for /api/sync/stream. Each open stream pins its own Redis
# pub/sub connection, so these are what stop one free account from exhausting
# Redis and failing readiness on every replica. Unset uses the defaults in
# src/routes/sync/stream_limits.rs (3 per account, 1000 per replica).
SSE_MAX_STREAMS_PER_USER=
SSE_MAX_STREAMS_TOTAL=
