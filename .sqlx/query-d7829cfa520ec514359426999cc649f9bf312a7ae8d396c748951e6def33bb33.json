  "query": "UPDATE configs SET version = v.version, client_uuid = $1, last_modified = $2, sync_state = 'SYNCED' FROM UNNEST($3::uuid[], $4::int4[], $5::uuid[]) AS v(id, version, device_uuid) WHERE configs.id = v.id AND configs.user_id = $6 AND configs.device_uuid = v.device_uuid RETURNING configs.id, configs.device_uuid, configs.version, configs.is_deleted, configs.last_modified, configs.key, configs.value",
